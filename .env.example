# Digital Twin UAV Engine — Environment Configuration
# Copy to .env and set values as needed

# ─── Backend ──────────────────────────────────────────────────────────────────
# Port for FastAPI server
PORT=8000
HOST=0.0.0.0

# SQLite database path (relative to project root)
DATABASE_URL=sqlite:///./data/digital_twin.db
# For production: PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/digital_twin

# ─── Simulator ────────────────────────────────────────────────────────────────
# Update rate for telemetry stream (Hz) [CONFIGURABLE]
TELEMETRY_UPDATE_RATE_HZ=1.0

# Seed random state for reproducible simulation [CONFIGURABLE]
SIMULATOR_SEED=42

# ─── ML ───────────────────────────────────────────────────────────────────────
# Directory for saved ML model files
ML_MODELS_DIR=./ml/models

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Frontend origin (adjust for production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Vite dev server port
VITE_PORT=5173
# API base URL (proxied by Vite in dev; change for production)
VITE_API_BASE=/api
VITE_WS_URL=ws://localhost:8000/ws

# ─── Notes ────────────────────────────────────────────────────────────────────
# ALL PARAMETERS SIMULATED / CONFIGURABLE
# See backend/engine_config.yaml for engine parameters
# DEMONSTRATION SYSTEM — Not for operational aerospace use
